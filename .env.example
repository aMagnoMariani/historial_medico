# =====================================================================
#  Ejemplo de configuración. Copia este archivo a .env y ajusta los valores:
#      cp .env.example .env
# =====================================================================

# --- Base de datos PostgreSQL ---
DB_NAME=clinica
DB_USER=postgres
DB_PASSWORD=pon_aqui_la_clave
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
# Clave secreta. Genera una nueva con:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=genera_una_clave_larga_y_secreta

# True solo en desarrollo. En el servidor del consultorio va en False.
DJANGO_DEBUG=False

# Hosts permitidos, separados por coma. La IP del servidor va aquí.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ip-del-servidor
